# ---------------------------------------------------------------------------
# RingCentral MCP — environment configuration
#
# Copy this file to `.env` and fill in every value. `.env` is git-ignored and
# must never be committed. See README.md for where each value comes from
# and how to rotate it.
# ---------------------------------------------------------------------------

# --- RingCentral -----------------------------------------------------------

# API host. Production: https://platform.ringcentral.com
# Sandbox/testing:      https://platform.devtest.ringcentral.com
RINGCENTRAL_SERVER_URL=

# App "Client ID" from the RingCentral Developer Console. Not secret, but
# identifies the app. (Console > your app > Credentials)
RINGCENTRAL_CLIENT_ID=

# SECRET. App "Client Secret" from the same Credentials screen.
RINGCENTRAL_CLIENT_SECRET=

# SECRET. Server-to-server JWT credential. Created under
# Console > Credentials > JWT. This is a long-lived key: anyone holding it can
# act as the RingCentral user it was issued for.
RINGCENTRAL_JWT=

# --- MCP over HTTP ---------------------------------------------------------
# Lets a hosted assistant (e.g. ChatGPT Work) reach the tools over the network.
# Local clients that launch the server themselves (Claude Desktop, Claude Code)
# use stdio instead and need none of these.

# SECRET. Bearer token the calling assistant must present. Self-generated:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The HTTP endpoint refuses to start if this is empty. Anyone holding it can
# read the whole RingCentral account through the tools.
MCP_AUTH_TOKEN=

# TCP port for the MCP HTTP endpoint. Default 8788 if left empty.
# Bound to 127.0.0.1 only — reach it through an HTTPS reverse proxy.
MCP_PORT=

# URL path the MCP endpoint is served on. Default /mcp if left empty.
MCP_PATH=

# Network interface the MCP endpoint binds to. Default 127.0.0.1 (this machine
# only), which is right when running directly on a server.
#
# IN DOCKER this must be 0.0.0.0 — the container's published port cannot reach
# a process bound to the container's own loopback. docker-compose.yml already
# sets it for you; you do not need to change it here.
MCP_BIND_ADDRESS=

# --- Outbound messaging (send_sms / send_mms) ------------------------------

# MASTER SAFETY SWITCH for sending real text messages.
#
# Leave as "false" (or empty) and the send tools validate everything, build the
# exact request, and return a preview — WITHOUT contacting RingCentral. Nothing
# is sent and no customer is contacted.
#
# Set to "true" only after acceptance testing, when real sending is meant to go
# live. The word "true" is accepted in any capitalisation, with surrounding
# spaces ignored. Anything else — "1", "yes", "on", a typo like "ture", or an
# empty value — is treated as FALSE, so a mistake can never switch sending on
# by accident.
ALLOW_REAL_SENDS=false

# Default sending number, used when a send omits "from". Must be one of the
# account's SMS-enabled numbers — the server checks, and refuses otherwise.
# Leave empty to require an explicit "from" on every send.
DEFAULT_SMS_FROM=

# Refuse an identical message to the same recipient inside this many seconds.
# Guards against an accidental double-send. Default 600 (10 minutes) if left
# empty. The comparison ignores capitalisation and extra spaces, and does not
# look at which number sent it, so changing the sender does not get around it.
DUPLICATE_SEND_WINDOW_SECONDS=

# --- Deleting call-log entries ---------------------------------------------

# MASTER SAFETY SWITCH for delete_call_log_entry, the only tool that destroys
# data. Deleting removes the whole call record — its history and its recording
# reference — and cannot be undone.
#
# Leave as "false" (or empty) and the tool will show what WOULD be deleted and
# refuse to act, even when a deletion is explicitly confirmed.
#
# Set to "true" (any capitalisation) only when deleting is genuinely intended.
# Anything else — "1", "yes", a typo — is treated as FALSE. Even with this on,
# the tool still requires an explicit confirmation for one specific call id.
ALLOW_DELETIONS=false

# --- RingCentral rate limiting ---------------------------------------------

# How many RingCentral API requests this server will make per minute.
#
# RingCentral limits its call-log and message endpoints to roughly 10 requests
# a minute. Going over earns a 60-second penalty, so the server paces itself to
# stay underneath. The default of 8 leaves headroom.
#
# Raise it only if RingCentral confirms a higher limit for your account.
# Lowering it makes large date ranges slower but gentler. Set to 0 to switch
# pacing off entirely (not recommended — the server will then hit 429s and wait
# out each one).
RC_MAX_REQUESTS_PER_MINUTE=8

# How many reverse proxies sit in front of this server.
#
# 0 (the default) means none — correct when you run it directly on your own
# computer. Behind the nginx setup in README.md it must be 1, and
# docker-compose.yml already sets that for you.
#
# This tells Express how much of the X-Forwarded-For header to believe when
# identifying a caller. Getting it wrong has real consequences: too low and the
# OAuth endpoints error out behind nginx (ChatGPT connects but no tools appear);
# too high, or the value "true", and a caller could forge the header. Use the
# actual number of proxies — nothing else.
TRUST_PROXY_HOPS=

# --- OAuth (needed only for ChatGPT Work) ----------------------------------
# ChatGPT's custom-connector screen offers OAuth only — it has no field for a
# static token — so the server runs a small OAuth 2.1 authorization server for
# it. Leave OAUTH_ISSUER_URL empty and OAuth stays off; the MCP_AUTH_TOKEN
# above keeps working for Claude Desktop, curl and scripts.

# The public HTTPS address of this server, with NO path and NO trailing slash.
# This is the OAuth "issuer" and must match exactly what clients discover.
#   Deployed: https://mcp.your-domain.com
#   Local testing only: http://localhost:8788
# Setting this switches OAuth ON, and then the three values below are required.
OAUTH_ISSUER_URL=

# SECRET. The password you type on the "Authorize access" screen when
# connecting ChatGPT. There is one user — this is their password. Choose
# something strong; anyone with it can connect a client to the account.
OAUTH_USER_PASSWORD=

# SECRET. Signs the issued OAuth access tokens. Self-generated:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every issued token, and ChatGPT will reconnect.
OAUTH_SIGNING_SECRET=

# How long an issued access token lasts, in seconds. Default 3600 (1 hour);
# clients refresh automatically. Minimum 60.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=

# Where connected clients are remembered, so a restart does not force you to
# reconnect ChatGPT. Default ./data/oauth-clients.json. In Docker this needs a
# writable volume — docker-compose.yml sets one up.
OAUTH_CLIENT_STORE_PATH=

# --- Playback proxy --------------------------------------------------------
# The server streams call recordings over its own small HTTP endpoint so that
# no RingCentral credential ever reaches the listener. See README.md.

# SECRET. Bearer token for programmatic access to GET /recording/:id.
# Self-generated — any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The proxy refuses to start if this is empty.
PLAYBACK_AUTH_TOKEN=

# SECRET. HMAC key used to sign short-lived playback links. Self-generated,
# same method as above. Changing it invalidates every outstanding link.
# The proxy refuses to start if this is empty.
SIGNING_SECRET=

# Public base URL of the playback endpoint, used to build playback links.
# Local development: http://localhost:8787
# Deployed:          https://recordings.your-domain.com   (see README.md)
# No trailing slash.
PLAYBACK_BASE_URL=

# TCP port the playback endpoint listens on. Default 8787 if left empty.
PLAYBACK_PORT=

# Network interface the playback endpoint binds to. Default 127.0.0.1, which
# means the server itself only — reach it through an HTTPS reverse proxy.
#
# IN DOCKER this must be 0.0.0.0 — the container's published port cannot reach
# a process bound to the container's own loopback. docker-compose.yml already
# sets it for you; you do not need to change it here.
#
# WARNING: outside Docker, 0.0.0.0 publishes call recordings on an unencrypted
# port to anything that can reach the machine.
PLAYBACK_BIND_ADDRESS=

# How long a signed playback link stays valid, in seconds.
# Default 900 (15 minutes) if left empty.
PLAYBACK_LINK_TTL_SECONDS=
